# Per-project credentials, loaded by direnv on `cd` into this repo and unloaded
# on the way out. Values come from the macOS Keychain; nothing secret is stored
# in this file, which is why it is committed.
#
# Why per-project rather than a global export in ~/.zshrc:
#
#   DIGITALOCEAN_TOKEN -- this machine has two DigitalOcean projects on
#   *different accounts* (aiform and telleztec-infra). One ambient token means
#   whichever directory you happen to be standing in inherits it. The
#   DigitalOcean driver creates and destroys real infrastructure, so the wrong
#   token is not a failed call you notice and retry -- it is a *successful*
#   operation against the wrong account.
#
#   ANTHROPIC_API_KEY -- today this and the personal key are the same value, so
#   there is no wrong-account hazard yet. It is scoped in anticipation of one:
#   aiform is expected to move to its own billing, and pointing this repo at its
#   own Keychain entry now means that switch is a one-line Keychain update
#   rather than a code change. Be precise about what this does and does not
#   achieve: it does NOT keep the key out of Claude Code. A session started
#   from an interactive shell *inside this repo* inherits it like any other
#   child process, and will authenticate with it rather than a subscription.
#   Under the separate-billing intent that is the desired behaviour -- work on
#   aiform bills aiform -- but it is the opposite of "scoping protects
#   subscription auth", which an earlier draft of this comment wrongly claimed.
#   Scoping also makes this repo's dependency explicit: scripts/run_system_tests.py
#   requires the key, and an ambient value made that requirement invisible.
#
# Store each value once (the bare -w prompts, keeping it out of shell history;
# note -a "$USER", matching the lookups below -- a mismatch silently creates a
# second entry that is never read):
#
#   security add-generic-password -U -a "$USER" -s DIGITALOCEAN_TOKEN_AIFORM -w
#   security add-generic-password -U -a "$USER" -s ANTHROPIC_API_KEY_AIFORM -w
#
# Then run `direnv allow` here. Each git worktree needs its own `direnv allow`
# -- records are keyed on path plus content, so editing this file also re-blocks
# it. Until allowed, direnv exports nothing and any global token is ambient
# again, announced only by a "direnv: error ... is blocked" line.
#
# PREREQUISITE -- remove any global `export DIGITALOCEAN_TOKEN` or
# `export ANTHROPIC_API_KEY` from ~/.zshrc. Not merely tidiness: direnv records
# the before/after environment, with values, in DIRENV_DIFF (base64'd zlib --
# obfuscated, not encrypted). When this file shadows a global, DIRENV_DIFF
# carries *both* values into every child process started here: pytest, pip
# install hooks, editor tasks, every command an AI agent runs. Verified
# empirically. tests/conftest.py's leak scanner is a value-substring search and
# cannot see a compressed copy.
#
# SCOPE OF THE GUARANTEE -- direnv runs from the interactive shell's prompt
# hook. It does *not* fire for non-interactive invocations: `bash script.sh`,
# `ssh host 'cd ~/src/aiform && ...'`, `(cd ~/src/aiform && pytest)`, cron, or
# an agent session whose environment was populated elsewhere. Those inherit
# whatever the parent had, and resolve_credentials() reads the env var first.
# This narrows the wrong-token window substantially; it does not close it.

# Export $1 from Keychain service $2, or export empty and explain why.
#
# Exporting empty on every failure path is load-bearing, not sloppy: it shadows
# any global of the same name, so resolve_credentials() (aiform/config.py) and
# missing_credentials() (scripts/run_system_tests.py) both treat it as absent
# and fail closed. Do NOT "tidy" this into `unset` -- that restores the global.
_kc_export() {
  local _name="$1" _service="$2" _val _status _errfile

  export "$_name="

  # No Keychain (any non-macOS host -- this repo is public and Apache-2.0, so
  # Linux clones are a real case). $_name has already been exported empty above,
  # which is the point: a global inherited from the parent shell must not
  # survive into this directory just because the lookup is unavailable.
  if ! command -v security >/dev/null 2>&1; then
    echo "direnv: no 'security' command (non-macOS?); $_name left empty." >&2
    echo "direnv: set it yourself, or use .aiform/credentials.env for the DO token." >&2
    return
  fi

  # stderr goes to its own file rather than being merged with 2>&1 -- a merge
  # would splice any warning that 'security' emits on a *successful* exit into
  # the middle of the credential, exporting a corrupted value silently.
  # A failed mktemp would leave _errfile empty, turning the redirect below into
  # a redirection error that never runs `security` at all -- reported as a
  # bogus "lookup failed (exit 1)" against an entry that may be perfectly fine.
  if ! _errfile=$(mktemp); then
    echo "direnv: mktemp failed; $_name left empty." >&2
    return
  fi
  _val=$(security find-generic-password -a "$USER" -s "$_service" -w 2>"$_errfile")
  _status=$?

  case $_status in
    0)
      if [ -n "$_val" ]; then
        export "$_name=$_val"
      else
        echo "direnv: Keychain entry $_service exists but is empty; $_name left empty." >&2
      fi
      ;;
    44)
      # 44 = SecKeychainSearchCopyNext: item not found. Only this case warrants
      # suggesting -U, which overwrites -- advising it for a locked keychain or
      # an ACL denial would destroy a working entry while claiming to repair a
      # missing one.
      echo "direnv: $_service not in Keychain. Store it with:" >&2
      echo "direnv:   security add-generic-password -U -a \"\$USER\" -s $_service -w" >&2
      ;;
    *)
      echo "direnv: Keychain lookup for $_service failed (exit $_status): $(cat "$_errfile")" >&2
      echo "direnv: $_name left empty. Do NOT re-run with -U before confirming the" >&2
      echo "direnv: entry is actually missing -- -U would overwrite it." >&2
      ;;
  esac

  rm -f "$_errfile"
}

# No platform branch here on purpose. _kc_export exports empty first and then
# handles a missing `security` itself, so the non-macOS path is already
# fail-closed. A `uname` guard would be a second place asserting the same
# invariant, which is how the two drift apart.
_kc_export DIGITALOCEAN_TOKEN DIGITALOCEAN_TOKEN_AIFORM
_kc_export ANTHROPIC_API_KEY  ANTHROPIC_API_KEY_AIFORM

unset -f _kc_export

# Per-project DigitalOcean credentials, loaded by direnv on `cd` into this repo
# and unloaded on the way out.
#
# This exists because two projects on this machine use DigitalOcean tokens --
# aiform and telleztec-infra -- and they are different accounts' worth of
# blast radius. A single global `export DIGITALOCEAN_TOKEN` in ~/.zshrc makes
# one of them ambient in every shell, so whichever project you happen to be in
# silently inherits it. For a tool like aiform, whose DigitalOcean driver
# creates and destroys real infrastructure, inheriting the wrong token is not a
# failed API call -- it is operating on the wrong account.
#
# There is no secret in this file, only a Keychain lookup, so it is committed.
# Store the token once with:
#
#   security add-generic-password -U -a juan -s DIGITALOCEAN_TOKEN_AIFORM -w
#
# The bare -w prompts, keeping the token out of your shell history. Then run
# `direnv allow` in this directory.

export DIGITALOCEAN_TOKEN=$(security find-generic-password \
  -a "$USER" -s DIGITALOCEAN_TOKEN_AIFORM -w 2>/dev/null)

if [ -z "$DIGITALOCEAN_TOKEN" ]; then
  echo "direnv: WARNING - DIGITALOCEAN_TOKEN_AIFORM not found in Keychain;" >&2
  echo "direnv:   run: security add-generic-password -U -a \"$USER\" -s DIGITALOCEAN_TOKEN_AIFORM -w" >&2
fi

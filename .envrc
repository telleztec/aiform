# Per-project DigitalOcean credentials, loaded by direnv on `cd` into this repo
# and unloaded on the way out.
#
# Why: two projects on this machine use DigitalOcean tokens -- aiform and
# telleztec-infra -- against different accounts. A single global
# `export DIGITALOCEAN_TOKEN` in ~/.zshrc makes one of them ambient in every
# shell, so whichever project you are standing in silently inherits it. The
# DigitalOcean driver creates and destroys real infrastructure, so the wrong
# token is not a failed API call you notice and retry -- it is a *successful*
# operation against the wrong account.
#
# There is no secret in this file, only a Keychain lookup, so it is committed.
# Store the token once with (note: same -a "$USER" as the lookup below; a
# mismatch here silently creates a second entry that is never read):
#
#   security add-generic-password -U -a "$USER" -s DIGITALOCEAN_TOKEN_AIFORM -w
#
# The bare -w prompts, keeping the token out of your shell history. Then run
# `direnv allow` in this directory.
#
# PREREQUISITE -- remove the global `export DIGITALOCEAN_TOKEN` from ~/.zshrc.
# This is not merely tidiness. direnv records the before/after environment,
# with values, in DIRENV_DIFF (base64'd zlib -- obfuscated, not encrypted).
# When this file shadows a global DIGITALOCEAN_TOKEN, DIRENV_DIFF therefore
# carries *both* tokens into every child process started here: pytest, pip
# install hooks, editor tasks, every command an AI agent runs. Verified
# empirically, not assumed. tests/conftest.py's leak scanner does a
# value-substring search and cannot see a compressed copy. Leaving the global
# export in place reintroduces, by a side channel, exactly the cross-account
# exposure this file exists to prevent.
#
# Each git worktree needs its own `direnv allow` -- allow records are keyed on
# path plus content. Until you run it, direnv exports nothing and the global
# token (if you kept one) is ambient again, announced only by a
# "direnv: error ... is blocked" line that is easy to scroll past.

if [ "$(uname -s)" = "Darwin" ]; then
  _do_token=$(security find-generic-password -a "$USER" -s DIGITALOCEAN_TOKEN_AIFORM -w 2>&1)
  _do_status=$?

  # Export unconditionally, even empty. This is deliberate: an empty value
  # shadows any global DIGITALOCEAN_TOKEN, and aiform's resolve_credentials()
  # treats empty as absent and falls through to .aiform/credentials.env and
  # then a clear error. Failing closed to "no credentials" is correct; falling
  # back to another account's token is not. Do NOT "tidy" this into
  # `unset DIGITALOCEAN_TOKEN` on the miss path -- that restores the global.
  export DIGITALOCEAN_TOKEN=""

  case $_do_status in
    0)
      export DIGITALOCEAN_TOKEN="$_do_token"
      ;;
    44)
      # 44 = SecKeychainSearchCopyNext: item not found. Only this case is
      # safe to advise -U on; -U overwrites, so suggesting it for a locked
      # keychain or an ACL denial would destroy a working entry.
      echo "direnv: DIGITALOCEAN_TOKEN_AIFORM not in Keychain. Store it with:" >&2
      echo "direnv:   security add-generic-password -U -a \"\$USER\" -s DIGITALOCEAN_TOKEN_AIFORM -w" >&2
      ;;
    *)
      echo "direnv: Keychain lookup failed (exit $_do_status): $_do_token" >&2
      echo "direnv: DIGITALOCEAN_TOKEN left empty. Do NOT re-run with -U before" >&2
      echo "direnv: checking whether the entry exists -- -U would overwrite it." >&2
      ;;
  esac

  unset _do_token _do_status
else
  # `security` is macOS-only. Rather than print advice that cannot be followed,
  # say nothing useful is happening and leave the environment alone: set
  # DIGITALOCEAN_TOKEN yourself, or use .aiform/credentials.env, which
  # resolve_credentials() reads as a fallback.
  echo "direnv: non-macOS host; DIGITALOCEAN_TOKEN not managed here." >&2
  echo "direnv: use .aiform/credentials.env or export it yourself." >&2
fi
